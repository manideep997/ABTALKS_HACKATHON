# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000

# ─── Google Gemini (Free Tier via Google AI Studio) ──────────────────────────
# Get your free key at: https://aistudio.google.com/
# No credit card required. Ensure you are on the FREE TIER, NOT a Vertex AI
# billing project, to avoid unexpected charges during the 48-hour build cycle.
#
# Once logged into AI Studio, check the model picker for the current free-tier
# flash model name and set it exactly here (e.g. gemini-1.5-flash or
# gemini-2.0-flash-exp). Do NOT hardcode it anywhere else — all pipeline
# modules read this value from config.js.
GEMINI_API_KEY=AIzaSy-your-gemini-free-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ─── Mock Mode ───────────────────────────────────────────────────────────────
# Set to true ONLY for local testing without a Gemini key.
# Any post generated in mock mode is tagged is_mock=1 in the DB and
# visibly badged [MOCK DATA] in the UI. NEVER leave this true in production.
ALLOW_MOCK_MODE=false

# ─── Scheduler ───────────────────────────────────────────────────────────────
# How often the in-process cron triggers an autonomous cycle.
# Default: every 30 minutes. For testing, set to: */2 * * * *
CRON_SCHEDULE=*/30 * * * *
